      "name": "Trello - Tarjetas"
    },
    {
      "parameters": {
        "jsCode": "function flattenNodeItems(nodeName) {\n  const raw = $(nodeName).all();\n  const out = [];\n\n  for (const item of raw) {\n    if (Array.isArray(item.json)) {\n      out.push(...item.json);\n    } else {\n      out.push(item.json);\n    }\n  }\n\n  return out;\n}\n\nfunction formatDate(dateStr) {\n  if (!dateStr) return null;\n  const d = new Date(dateStr);\n  return d.toLocaleString('es-ES', {\n    day: '2-digit',\n    month: '2-digit',\n    year: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit',\n  });\n}\n\nfunction getDueStatus(due, dueComplete) {\n  if (!due) return null;\n  if (dueComplete) return '✅ completada';\n\n  const now = new Date();\n  const dueDate = new Date(due);\n\n  const diffMs = dueDate - now;\n  const diffHours = diffMs / (1000 * 60 * 60);\n\n  if (diffMs < 0) return '🔴 vencida';\n  if (diffHours <= 24) return '🟠 vence en menos de 24h';\n  return '🟡 pendiente';\n}\n\nfunction formatLabels(labels) {\n  if (!Array.isArray(labels) || labels.length === 0) return null;\n\n  return labels.map(label => {\n    if (label.name && label.name.trim()) return label.name.trim();\n    if (label.color) return `Etiqueta ${label.color}`;\n    return 'Etiqueta';\n  }).join(', ');\n}\n\nconst lists = flattenNodeItems(\"Trello - Listas\");\nconst cards = flattenNodeItems(\"Trello - Tarjetas\").filter(card => !card.closed);\n\nconst listMap = {};\nfor (const list of lists) {\n  listMap[list.id] = list.name;\n}\n\nconst store = $getWorkflowStaticData('global');\nif (!store.cards) store.cards = {};\n\nconst currentState = {};\nfor (const card of cards) {\n  currentState[card.id] = {\n    idList: card.idList,\n    listName: listMap[card.idList] || card.idList,\n    name: card.name,\n    url: card.url,\n    dateLastActivity: card.dateLastActivity,\n    labels: formatLabels(card.labels),\n    due: card.due,\n    dueFormatted: formatDate(card.due),\n    dueComplete: !!card.dueComplete,\n    dueStatus: getDueStatus(card.due, card.dueComplete),\n  };\n}\n\n// Primera ejecución: solo guarda estado y no envía nada\nif (!store.initialized) {\n  store.cards = currentState;\n  store.initialized = true;\n  return [];\n}\n\nconst output = [];\n\nfor (const [cardId, current] of Object.entries(currentState)) {\n  const previous = store.cards[cardId];\n\n  if (!previous) {\n    continue;\n  }\n\n  if (previous.idList !== current.idList) {\n    let text = `🔔 Cambio en Trello\nFicha: ${current.name}\nDe: ${previous.listName || previous.idList}\nA: ${current.listName || current.idList}`;\n\n    if (current.labels) {\n      text += `\\nEtiquetas: ${current.labels}`;\n    }\n\n    if (current.dueFormatted) {\n      text += `\\nEntrega: ${current.dueFormatted}`;\n    }\n\n    if (current.dueStatus) {\n      text += `\\nEstado fecha: ${current.dueStatus}`;\n    }\n\n    text += `\\n${current.url}`;\n\n    output.push({\n      json: {\n        cardId,\n        cardName: current.name,\n        fromList: previous.listName || previous.idList,\n        toList: current.listName || current.idList,\n        cardUrl: current.url,\n        labels: current.labels,\n        due: current.dueFormatted,\n        dueStatus: current.dueStatus,\n        text,\n      }\n    });\n  }\n}\n\nstore.cards = currentState;\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
