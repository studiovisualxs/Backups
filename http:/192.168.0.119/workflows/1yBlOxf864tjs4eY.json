    {
      "parameters": {
        "jsCode": "const config = $('Normalizar configuración').first().json;\nconst allInputs = $input.all();\n\nconst keywords = config.keywords || [];\nconst excludeKeywords = config.exclude_keywords || [];\nconst provincias = config.provincias || [];\nconst cpvs = config.cpvs || [];\nconst maxResultados = Number(config.max_resultados || 100);\n\nfunction textOf(value) {\n  if (!value) return '';\n  if (typeof value === 'string') return value;\n  if (value._) return value._;\n  if (value['#text']) return value['#text'];\n  return JSON.stringify(value);\n}\n\nfunction normalizeCpv(value) {\n  return String(value || '')\n    .toLowerCase()\n    .replace(/[^0-9]/g, '');\n}\n\nfunction getEntries(xml) {\n  const feed = xml.feed || xml;\n  let entries = feed.entry || [];\n\n  if (!entries) return [];\n  if (!Array.isArray(entries)) entries = [entries];\n\n  return entries;\n}\n\nconst resultados = [];\n\nfor (const input of allInputs) {\n  const entries = getEntries(input.json);\n\n  for (const entry of entries) {\n    const title = textOf(entry.title);\n    const summary = textOf(entry.summary);\n    const id = textOf(entry.id);\n    const updated = textOf(entry.updated);\n    const content = textOf(entry.content);\n\n    let link = '';\n\n    if (Array.isArray(entry.link)) {\n      const alt = entry.link.find(l => l.rel === 'alternate') || entry.link[0];\n      link = alt?.href || '';\n    } else if (entry.link) {\n      link = entry.link.href || '';\n    }\n\n    const texto = JSON.stringify(entry).toLowerCase();\n    const textoCpvNormalizado = normalizeCpv(texto);\n\n    const pasaKeyword =\n      keywords.length === 0 ||\n      keywords.some(k => texto.includes(String(k).toLowerCase()));\n\n    const pasaExclusion =\n      excludeKeywords.length === 0 ||\n      !excludeKeywords.some(k => texto.includes(String(k).toLowerCase()));\n\n    const pasaProvincia =\n      provincias.length === 0 ||\n      provincias.some(p => texto.includes(String(p).toLowerCase()));\n\n    const pasaCpv =\n      cpvs.length === 0 ||\n      cpvs.some(cpv => {\n        const cpvNormalizado = normalizeCpv(cpv);\n        return cpvNormalizado && textoCpvNormalizado.includes(cpvNormalizado);\n      });\n\n    if (pasaKeyword && pasaExclusion && pasaProvincia && pasaCpv) {\n      resultados.push({\n        id,\n        title,\n        summary,\n        updated,\n        link,\n      });\n    }\n  }\n}\n\nconst unicos = Array.from(\n  new Map(\n    resultados.map(r => [\n      r.id || r.link || r.title,\n      r,\n    ])\n  ).values()\n);\n\nconst salida = unicos.slice(0, maxResultados);\n\nif (salida.length === 0) {\n  return [{\n    json: {\n      id: 'sin-resultados',\n      title: 'No se encontraron licitaciones con los filtros actuales',\n      summary: 'Prueba ampliando keywords, quitando CPV o dejando provincia vacía.',\n      updated: new Date().toISOString(),\n      link: '',\n    }\n  }];\n}\n\nreturn salida.map(r => ({ json: r }));"
      },
