    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst config = $('Normalizar configuración').first().json;\n\nconst rows = items.map((item, index) => {\n  const r = item.json;\n  return `\n    <tr>\n      <td>${index + 1}</td>\n      <td><strong>${r.title || ''}</strong><br>${r.summary || ''}</td>\n      <td><a href=\"${r.link || '#'}\">Ver licitación</a></td>\n      <td>${r.updated || ''}</td>\n    </tr>\n  `;\n}).join('');\n\nconst html = `\n<h2>Nuevas licitaciones encontradas</h2>\n<p>Se han encontrado <strong>${items.length}</strong> licitaciones.</p>\n\n<table border=\"1\" cellpadding=\"8\" cellspacing=\"0\">\n  <thead>\n    <tr>\n      <th>#</th>\n      <th>Licitación</th>\n      <th>Enlace</th>\n      <th>Fecha</th>\n    </tr>\n  </thead>\n  <tbody>\n    ${rows}\n  </tbody>\n</table>\n`;\n\nreturn [{\n  json: {\n    email_destino: config.email_destino,\n    subject: `Alertas licitaciones: ${items.length} resultados`,\n    html,\n  }\n}];"
      },
