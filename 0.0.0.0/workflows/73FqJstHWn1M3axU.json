        "jsCode": "return items.map(item => {\n  const filename =\n    $('Preparar HTML PDF').item.json.pdf_filename ||\n    `${$('Preparar fila Resultado').item.json.cuenta || 'reporte'}.pdf`;\n\n  item.binary.data.fileName = filename;\n  item.binary.data.mimeType = 'application/pdf';\n  item.binary.data.fileExtension = 'pdf';\n\n  return item;\n});"
