      "id": "810dd977-20f8-4d15-b4e5-d87d672f3e27",
      "name": "Browserless Scraper"
    },
    {
      "parameters": {
        "jsCode": "const browserlessItems = $input.all();\nconst sourceItems = $('Filter').all();\n\nreturn browserlessItems.map((item, index) => {\n  const source = sourceItems[index]?.json || {};\n  const response = item.json || {};\n\n  const result =\n    response.data?.[0]?.results?.[0] ||\n    response.results?.[0] ||\n    {};\n\n  const rawText = result.text || response.text || '';\n  const rawHtml = result.html || response.html || '';\n\n  const cleanHtml = rawHtml\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#039;/g, \"'\")\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  const texto_limpio = (rawText || cleanHtml || '')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, 6000);\n\n  const textoBloqueado =\n    /log in to continue|facebook no cookie|inicia sesi[oó]n|debes iniciar sesi[oó]n/i.test(texto_limpio);\n\n  const scrape_ok = texto_limpio.length > 100 && !textoBloqueado;\n\n  return {\n    json: {\n      row_number: source.row_number,\n      nombre: source.nombre,\n      url: source.url,\n      tipo: source.tipo,\n      activo: source.activo,\n      palabras_clave: source.palabras_clave,\n\n      texto_limpio,\n      scrape_ok,\n      scrape_status: scrape_ok ? 'OK' : 'SIN_TEXTO_UTIL',\n      scrape_motivo: textoBloqueado\n        ? 'Facebook muestra login o bloqueo'\n        : texto_limpio.length <= 100\n          ? 'Texto demasiado corto'\n          : 'OK',\n    },\n  };\n});"
      },
