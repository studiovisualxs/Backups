        "url": "http://browserless:3000/scrape?token=n8n_browserless_2026",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{$json.url}}\",\n  \"elements\": [\n    {\n      \"selector\": \"body\"\n    }\n  ],\n  \"gotoOptions\": {\n    \"waitUntil\": \"domcontentloaded\",\n    \"timeout\": 60000\n  }\n}",
        "options": {}
      },
