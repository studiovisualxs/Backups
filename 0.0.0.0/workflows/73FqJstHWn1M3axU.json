    {
      "parameters": {
        "jsCode": "const item = $json;\n\n// El resultado de Ollama puede venir como objeto { content: \"...\" }\n// o como texto plano, según el nodo/modelo.\nlet promptFinal = '';\n\nif (typeof item.content === 'string') {\n  promptFinal = item.content;\n} else if (item.message?.content) {\n  promptFinal = item.message.content;\n} else if (item.text) {\n  promptFinal = item.text;\n} else if (item.response) {\n  promptFinal = item.response;\n} else if (item.prompt) {\n  if (typeof item.prompt === 'string') {\n    try {\n      const parsed = JSON.parse(item.prompt);\n      promptFinal = parsed.content || item.prompt;\n    } catch {\n      promptFinal = item.prompt;\n    }\n  } else if (item.prompt.content) {\n    promptFinal = item.prompt.content;\n  }\n}\n\n// Datos originales desde nodos anteriores\nconst original = $('Code in JavaScript').item.json;\n\nreturn [\n  {\n    json: {\n      fecha: new Date().toISOString().slice(0, 10),\n      cuenta: original.nombre || original.cuenta || '',\n      texto: original.texto_limpio || '',\n      prompt: promptFinal,\n      imagen_url: original.imagen_url || '',\n      post_url: original.url || original.post_url || '',\n      categoria: original.palabras_clave || original.categoria || '',\n      exportado_pdf: 'NO',\n    },\n  },\n];"
      },
